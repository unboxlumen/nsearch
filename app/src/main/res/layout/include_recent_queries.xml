<?xml version="1.0" encoding="utf-8"?>
<!-- 最近搜索词 Chip 行（仅空闲态可见）。
     横向滚动的 ChipGroup，由 RecentQueriesController 填充。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recentGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_lg"
    android:paddingEnd="@dimen/space_lg"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recent_searches"
            android:textAppearance="@style/TextAppearance.NSearch.Tertiary"
            android:textAllCaps="true"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/recentClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_xs"
            android:text="@string/recent_clear"
            android:textAppearance="@style/TextAppearance.NSearch.Meta"
            android:textColor="?attr/colorPrimary"
            android:focusable="true"
            android:clickable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:scrollbars="none"
        android:fillViewport="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/recentChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/space_2xl"
            app:singleLine="true"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </HorizontalScrollView>
</LinearLayout>