<?xml version="1.0" encoding="utf-8"?>
<!-- 主页（搜索）：纯白极简 / 苹果风重构版。
     结构（自上而下）：
       ① AppBar（大标题 + 索引入口 + 进度条）          —— include_app_bar
       ② 搜索区（圆角输入框 + 同义词文字按钮）          —— 独立行
       ③ Chip 行（严格 / 中等 / 宽松）                  —— 独立行
       ④ 结果计数行                                    —— 13sp 次色
       ⑤ 最近搜索词 / 列表 / 三态容器（互斥可见）       —— 弹性
     旧底部 progressCard 已删除；索引进度上移至 AppBar 进度条。
     见 UI_DESIGN_GUIDE.md §2 / §6 / §8 / §10。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="?android:attr/colorBackground">

    <!-- 兼容：保留 R.id.toolbar 可解析（不可见占位,新版本由 include_app_bar.xml 提供大标题）
         不可见是为了避免 Material 标题栏与新 AppBar 冲突。 -->
    <View
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <include
        android:id="@+id/appBarHeader"
        layout="@layout/include_app_bar" />

    <!-- ═══ 搜索区（独立行，不再与高级按钮同行） ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xs">

        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/radius_input"
            app:cardElevation="0dp"
            app:strokeWidth="@dimen/stroke_thin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_xs">

                <ImageView
                    android:id="@+id/btnSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search"
                    android:importantForAccessibility="no"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/cd_advanced" />

                <EditText
                    android:id="@+id/searchBox"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.NSearch.Body"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary" />

                <ImageView
                    android:id="@+id/btnClear"
                    android:layout_width="@dimen/touch_target"
                    android:layout_height="@dimen/touch_target"
                    android:padding="@dimen/space_md"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/cd_clear_query" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- ═══ Chip 行：匹配精度 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_sm">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/modeChipGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeStrict"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_strict"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeMedium"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_medium"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipModeLoose"
                style="?attr/chipStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_loose"
                android:checkable="true" />
        </com.google.android.material.chip.ChipGroup>

        <!-- 同义词文字按钮（替代旧底部抽屉里的 Switch） -->
        <TextView
            android:id="@+id/synonymToggle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_compact"
            android:gravity="center"
            android:paddingStart="@dimen/space_sm"
            android:paddingEnd="@dimen/space_sm"
            android:text="@string/settings_synonym"
            android:textAppearance="@style/TextAppearance.NSearch.Meta"
            android:textColor="?attr/colorPrimary"
            android:focusable="true"
            android:clickable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- ═══ 结果计数行（13sp / 次色） ═══ -->
    <TextView
        android:id="@+id/resultCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_sm"
        android:textAppearance="@style/TextAppearance.NSearch.Meta" />

    <!-- ═══ 最近搜索词（仅空闲态可见） ═══ -->
    <include
        android:id="@+id/recentQueries"
        layout="@layout/include_recent_queries" />

    <!-- ═══ 结果 / 三态容器（互斥可见） ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 结果列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/list_bottom_extra"
            android:scrollbars="vertical" />

        <!-- 空 / 错误三态容器（由 EmptyStateView 渲染） -->
        <com.unbox.nsearch.ui.EmptyStateView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ═══ 旧进度详情卡保留：MainActivity 会在重构路径下不再使用它，
         但保留 ID 以便任何缓存引用不报 NullPointerException。 ═══ -->
    <View
        android:id="@+id/progressCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="UnusedAttribute" />

</LinearLayout>