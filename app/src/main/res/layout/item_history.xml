<?xml version="1.0" encoding="utf-8"?>
<!-- 历史项：状态徽章 + 时间 + meta 行 + 路径行（默认隐藏，点击展开）。
     触控区满宽，padding 16dp / 14dp；徽章为 pill（§6）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_md">

        <!-- 第一行：左时间，右状态徽章（pill） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_folder"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/historyTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.NSearch.Section"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/historyStatusBadge"
                style="@style/Widget.NSearch.StatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                tools:ignore="HardcodedText"
                android:text="成功" />
        </LinearLayout>

        <!-- 第二行：meta 信息（成功/失败/跳过 + 用时） -->
        <TextView
            android:id="@+id/historySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.NSearch.Meta" />

        <!-- 第三行：路径（默认隐藏，点开展开） -->
        <TextView
            android:id="@+id/historyPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.NSearch.Tertiary"
            android:singleLine="true"
            android:ellipsize="middle"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>