<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- 单一主色（§3 单一主色） -->
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- 表面与文字 -->
        <item name="android:colorBackground">@color/bg_day</item>
        <item name="colorSurface">@color/surface_day</item>
        <item name="colorOnSurface">@color/text_day</item>

        <item name="colorText">@color/text_day</item>
        <item name="colorOutline">@color/outline_day</item>
        <item name="colorTextTertiary">@color/text_tertiary_day</item>

        <item name="colorStateSuccess">@color/state_success_day</item>
        <item name="colorStateFailed">@color/state_failed_day</item>
        <item name="colorStateSkipped">@color/state_skipped_day</item>

        <!-- 状态栏与工具栏同色（白底），深色文字 -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">@bool/config_lightStatusBar</item>

        <item name="android:textColorPrimary">@color/text_day</item>
        <item name="android:textColorSecondary">@color/text_secondary_day</item>

        <!-- 扁平：禁用 elevationOverlay；阴影交给 1dp 描边 -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- 控件样式统一收敛到这里（§1 一致大于个性） -->
        <item name="toolbarStyle">@style/Widget.NSearch.Toolbar</item>
        <item name="materialCardViewStyle">@style/Widget.NSearch.Card</item>
        <item name="chipStyle">@style/Widget.NSearch.Chip</item>
    </style>

    <!-- 旧的 Widget.NSearch.Toolbar / Card / Chip 保留引用同名以保持兼容；
         新版定义在 styles.xml 中。这里不再重复定义。 -->

</resources>