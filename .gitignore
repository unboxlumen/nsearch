# Built application / Gradle build outputs
# Match build dirs at any level (root, app/, module/)
**/build/
*.apk
*.aar
*.jar
*.war
*.class
*.dex
gen/
captures/
.externalNativeBuild/
.cxx/
.kotlin/

# Local configuration (SDK path, etc.)
local.properties

# Signing keys — never commit keystores / key material (keep shared debug keystore for reproducible builds)
*.jks
*.keystore
!signing/debug.keystore

# IDE / editor
.idea/
*.iml
# Gradle (ignore local Gradle cache only; wrapper is committed for reproducible builds)
.gradle/
# Re-include the committed Gradle wrapper jar (overrides *.jar above)
!gradle/wrapper/gradle-wrapper.jar
.vscode/
.DS_Store

# Tool / environment cruft
.superpowers/
.trae-html-share-packages/

# UI screenshots / design reference captures (binary, not source)
shots/

# WorkBuddy assistant internal data (not project source)
.workbuddy/
